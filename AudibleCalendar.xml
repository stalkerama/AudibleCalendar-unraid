<?xml version="1.0"?>
<Container version="2">
  <Name>AudibleCalendar</Name>
  <Repository>ghcr.io/stalkerama/audiblecalendar:latest</Repository>
  <Registry>https://github.com/stalkerama/AudibleCalendar-unraid/pkgs/container/audiblecalendar</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/brandochdaha/AudibleCalendar/issues</Support>
  <Project>https://github.com/brandochdaha/AudibleCalendar</Project>
  <Overview>Track upcoming Audible releases from followed authors and series. Image is built daily from upstream main. See https://github.com/stalkerama/AudibleCalendar-unraid</Overview>
  <WebUI>http://[IP]:[PORT:8000]/</WebUI>
  <ExtraParams>--security-opt=no-new-privileges:true --cap-drop=ALL</ExtraParams>
  <Config Name="Web UI" Target="8000" Default="18000" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">18000</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/cache/appdata/audiblecalendar" Mode="rw" Description="Persistent data, owned by UID and GID 10001" Type="Path" Display="always" Required="true" Mask="false">/mnt/cache/appdata/audiblecalendar</Config>
</Container>
